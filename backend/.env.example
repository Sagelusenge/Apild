NODE_ENV=development
PORT=4000
API_PREFIX=/api
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=apild_platform
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_ACCESS_SECRET=CHANGE_ME_WITH_AT_LEAST_32_CHARACTERS_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_WITH_AT_LEAST_32_CHARACTERS_REFRESH
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_ROUNDS=12
ALLOW_PUBLIC_REGISTRATION=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=CHANGE_ME
SMTP_AUTH_TYPE=password
SMTP_CLIENT_ID=
SMTP_CLIENT_SECRET=
SMTP_REFRESH_TOKEN=
SMTP_ACCESS_TOKEN=
MAIL_FROM=APILD <no-reply@apild.local>

UPLOAD_MAX_SIZE_MB=10
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
ENABLE_JOBS=false
TRUST_PROXY=false
